{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "NODE_OPTIONS='--max-old-space-size=4096' GOMAXPROCS=1 vite build",
        "build:safe": "NODE_OPTIONS='--max-old-space-size=4096' GOMAXPROCS=1 vite build --minify terser",
        "build:esbuild": "NODE_OPTIONS='--max-old-space-size=4096' GOMAXPROCS=1 USE_ESBUILD_MINIFY=true vite build",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "terser": "^5.36.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.1",
        "vue": "^3.5.24"
    }
}
